+function isAcpProviderId(providerId: unknown): boolean {
+  return (
+    typeof providerId === "string" &&
+    providerId.startsWith(ACP_PROVIDER_ID_PREFIX)
+  );
+}
+
+async function resolveProviderId(
+  bb: BbPluginApi,
+  ctx: { threadId: string; providerId?: unknown },
+): Promise<string | null> {
+  if (typeof ctx.providerId === "string") return ctx.providerId;
+  try {
+    const thread = await bb.sdk.threads.get({ threadId: ctx.threadId });
+    const providerId = (thread as { providerId?: unknown }).providerId;
+    return typeof providerId === "string" ? providerId : null;
+  } catch (error) {
+    bb.log.warn(
