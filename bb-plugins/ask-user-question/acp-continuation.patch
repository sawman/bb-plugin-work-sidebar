 export const TOOL_NAME = "AskUserQuestion";
 export const RENDERER_ID = ASK_USER_QUESTION_RENDERER_ID;
 
+// ACP clients own the MCP request deadline and may terminate an interactive
+// tools/call while the user is still reading the question. The server cannot
+// extend that deadline reliably, so all ACP providers use a two-step flow:
+// return as soon as the interaction is shown, then steer the answer back to
+// the thread when it arrives. Native-question providers are withheld above.
+// Revisit when ACP specifies a durable interactive tool-call continuation.
+const ACP_PROVIDER_ID_PREFIX = "acp-";
+const ACP_PENDING_RESULT =
+  "Question shown. Wait for the user's follow-up answer before continuing.";
+
 function errorResult(message: string): PluginAgentToolResult {
   return { content: [{ type: "text", text: message }], isError: true };
 }
 
+function isAcpProviderId(providerId: string): boolean {
+  return providerId.startsWith(ACP_PROVIDER_ID_PREFIX);
+}
+
+async function deliverAcpAnswer(args: {
+  bb: BbPluginApi;
+  threadId: string;
+  payload: ReturnType<typeof buildInteractionPayload>;
+  result: Awaited<ReturnType<BbPluginApi["ui"]["requestInput"]>>;
+}): Promise<void> {
+  const { bb, threadId, payload, result } = args;
+  if (result.outcome !== "submitted") return;
+
+  const parsed = interactionResponseSchema.safeParse(result.value);
+  if (!parsed.success) {
+    bb.log.warn("AskUserQuestion could not read an ACP answer");
+    return;
+  }
+  const toolResult = buildToolResult(payload, parsed.data);
+  if (Object.keys(toolResult.answers).length === 0) {
+    bb.log.info("AskUserQuestion ACP answer was empty");
+    return;
+  }
+
+  try {
+    await bb.sdk.threads.send({
+      threadId,
+      mode: "steer-if-active",
+      input: [
+        {
+          type: "text",
+          text: `AskUserQuestion answer:\n${JSON.stringify(toolResult)}`,
+          mentions: [],
+          visibility: "agent-only",
+        },
+      ],
+    });
+  } catch (error) {
+    bb.log.warn(
+      `Could not deliver AskUserQuestion answer to ACP: ${
+        error instanceof Error ? error.message : String(error)
+      }`,
+    );
+  }
+}
