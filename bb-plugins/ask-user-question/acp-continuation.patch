+          status,
+          value,
+        });
+        if (status === "active") {
+          seedTurnStarted(harness.deps, {
+            environmentId: environment.id,
+            threadId: thread.id,
+            turnId: `turn-non-blocking-${status}`,
+            providerThreadId: `provider-send-dispatch-${value}`,
+          });
+        }
+        const pending = requestPluginForm(harness, {
+          threadId: thread.id,
+          nonBlocking: true,
+        });
+
+        await expect(
+          acceptThreadSendRequest(harness.deps, {
+            payload: autoSendPayload(`answer while ${status}`),
+            thread,
+          }),
+        ).resolves.toMatchObject({ ok: true, delivery: "sent" });
+        expect(listQueuedThreadMessages(harness.db, thread.id)).toEqual([]);
+
+        cancelPluginForm(harness, thread.id);
+        await expect(pending).resolves.toMatchObject({ outcome: "cancelled" });
+      });
+    },
+  );
+
+  it("continues to queue an auto-send behind an ordinary blocking form", async () => {
